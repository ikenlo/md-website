# Скопіюйте у .env і заповніть. Файл .env НЕ комітимо (він у .gitignore).
PORT=8080

# Базова адреса API MDs connect
MDS_CONNECT_URL=https://api.mds-connect.example/v1/salons/md-kyiv-1

# Секретний токен / API-ключ з кабінету MDs connect
MDS_CONNECT_TOKEN=

# Як MDs connect очікує токен (за замовчуванням: "Authorization: Bearer <token>")
# MDS_CONNECT_AUTH_HEADER=X-Api-Key
# MDS_CONNECT_AUTH_PREFIX=
